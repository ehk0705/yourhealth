<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Maladies de la thyroïde | Pathologie</title>

  <style>
    :root{
      --bg:#0b1220;
      --card:#121b2e;
      --txt:#eef2ff;
      --muted:#b9c2d6;
      --accent:#7dd3fc;
      --border:rgba(255,255,255,.12);
      --ok:#34d399;
      --warn:#facc15;
      --bad:#fb7185;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
      background:linear-gradient(180deg,#070b14,var(--bg));
      color:var(--txt);
      line-height:1.55;
    }
    a{color:inherit}
    header{
      position:sticky; top:0; z-index:50;
      background:rgba(0,0,0,.25);
      backdrop-filter:blur(8px);
      border-bottom:1px solid var(--border);
    }
    .topbar{
      max-width:1100px;
      margin:0 auto;
      padding:14px 16px;
      display:flex;
      gap:12px;
      align-items:center;
      justify-content:space-between;
    }
    nav{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      align-items:center;
    }
    nav a{
      text-decoration:none;
      padding:8px 10px;
      border:1px solid var(--border);
      border-radius:12px;
      color:var(--txt);
      opacity:.95;
    }
    nav a:hover{border-color:rgba(125,211,252,.5)}
    .wrap{max-width:1100px;margin:0 auto;padding:18px 16px 40px}

    .hero{
      background:linear-gradient(180deg,#0b1220,#1a2233);
      border:1px solid var(--border);
      border-radius:18px;
      padding:16px;
      margin:14px 0 16px;
      overflow:hidden;
    }
    .hero-top{
      display:flex;
      gap:14px;
      align-items:flex-start;
      justify-content:space-between;
    }
    .hero h1{margin:0 0 6px;font-size:1.45rem}
    .hero p{margin:0;color:var(--muted)}
    .hero-figure{
      width:220px;
      flex:0 0 220px;
    }
    .hero-figure img{
      width:100%;
      height:140px;
      object-fit:cover;
      border-radius:16px;
      border:1px solid var(--border);
      background:rgba(0,0,0,.18);
    }
    @media (max-width:780px){
      .hero-top{flex-direction:column}
      .hero-figure{width:100%;flex:0 0 auto}
      .hero-figure img{height:170px}
    }

    .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
    .chip{
      border:1px solid var(--border);
      border-radius:999px;
      padding:6px 10px;
      font-size:.92rem;
      color:var(--txt);
      opacity:.95;
    }

    .grid{
      display:grid;
      grid-template-columns:1.2fr .8fr;
      gap:14px;
      align-items:start;
    }
    @media (max-width:900px){
      .grid{grid-template-columns:1fr}
    }

    .card{
      background:rgba(18,27,46,.85);
      border:1px solid var(--border);
      border-radius:18px;
      padding:14px;
      box-shadow:0 10px 30px rgba(0,0,0,.18);
    }
    .card h2{margin:0 0 10px;font-size:1.1rem}
    .card h3{margin:14px 0 8px;font-size:1rem}
    .muted{color:var(--muted)}
    ul{margin:8px 0 0 18px;padding:0}
    li{margin:6px 0}

    .badge{
      display:inline-flex;
      align-items:flex-start;
      gap:8px;
      padding:10px 12px;
      border-radius:14px;
      border:1px solid var(--border);
      margin:8px 0 0;
      color:var(--txt);
      background:rgba(0,0,0,.10);
    }
    .dot{width:10px;height:10px;border-radius:999px;display:inline-block;margin-top:5px}
    .dot.ok{background:var(--ok)}
    .dot.warn{background:var(--warn)}
    .dot.bad{background:var(--bad)}

    details{
      border:1px solid var(--border);
      border-radius:14px;
      padding:10px 12px;
      background:rgba(0,0,0,.12);
      margin:10px 0;
    }
    summary{
      cursor:pointer;
      font-weight:600;
      list-style:none;
    }
    summary::-webkit-details-marker{display:none}

    .kpi{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
      margin-top:12px;
    }
    @media (max-width:520px){
      .kpi{grid-template-columns:1fr}
    }
    .kpi .mini{
      border:1px solid var(--border);
      border-radius:14px;
      padding:10px;
      background:rgba(0,0,0,.10);
    }
    .mini .t{font-weight:650;margin:0 0 6px}
    .mini .p{margin:0;color:var(--muted);font-size:.95rem}

    .sep{height:1px;background:var(--border);margin:12px 0}

    .media{
      display:flex;
      gap:12px;
      align-items:flex-start;
      margin-top:10px;
    }
    .media img{
      width:170px;
      height:120px;
      object-fit:cover;
      border-radius:16px;
      border:1px solid var(--border);
      background:rgba(0,0,0,.18);
      flex:0 0 170px;
    }
    .media .txt{flex:1}
    @media (max-width:700px){
      .media{flex-direction:column}
      .media img{width:100%;height:170px;flex:0 0 auto}
    }

    footer{
      max-width:1100px;
      margin:0 auto;
      padding:18px 16px 28px;
      color:var(--muted);
      border-top:1px solid var(--border);
    }
    .small{font-size:.92rem}
  </style>
</head>

<body>
<header>
  <div class="topbar">
    <div class="muted" style="font-weight:700;">YourHealth</div>
    <nav>
      <a href="/yourhealth/index.html">Accueil</a>
      <a href="/yourhealth/ressources.html">Ressources</a>
      <a href="/yourhealth/contact.html">Contact</a>
    </nav>
  </div>
</header>

<main class="wrap">
  <section class="hero">
    <div class="hero-top">
      <div>
        <h1>Maladies de la thyroïde</h1>
        <p>La thyroïde est une glande du cou. Ses maladies sont fréquentes et se traitent souvent bien, à condition d’être correctement diagnostiquées.</p>
        <div class="chips" aria-label="Mots-clés">
          <span class="chip">Hypothyroïdie</span>
          <span class="chip">Hyperthyroïdie</span>
          <span class="chip">Goitre</span>
          <span class="chip">Nodules</span>
          <span class="chip">Thyroïdite</span>
        </div>
      </div>

      <!-- Image d'en-tête (mettre une image dans assets/img/thyroide.jfif ou .jpg/.png) -->
      <figure class="hero-figure" aria-label="Illustration thyroïde">
        <img data-slug="thyroide" alt="Illustration : thyroïde" loading="lazy" decoding="async">
      </figure>
    </div>
  </section>

  <section class="grid">
    <article class="card">
      <h2>1) À quoi sert la thyroïde ?</h2>

      <div class="media">
        <!-- Image de mécanisme (mettre assets/img/hormones-thyroidiennes.*) -->
        <img data-slug="hormones-thyroidiennes" alt="Hormones thyroïdiennes (T3/T4/TSH)" loading="lazy" decoding="async">
        <div class="txt">
          <p class="muted">
            Elle produit des hormones (principalement T4 et T3) qui participent au rythme du corps :
            énergie, température, cœur, transit, humeur, peau, cheveux, muscles.
          </p>
          <div class="kpi">
            <div class="mini">
              <p class="t">TSH</p>
              <p class="p">Signal de commande venant de l’hypophyse. Très utile pour dépister un dérèglement.</p>
            </div>
            <div class="mini">
              <p class="t">T4 libre / T3</p>
              <p class="p">Hormones mesurées pour confirmer et préciser le diagnostic.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="sep"></div>

      <h2>2) Les principales maladies</h2>

      <details open>
        <summary>Hypothyroïdie (thyroïde trop lente)</summary>
        <ul>
          <li>Fatigue inhabituelle, somnolence, frilosité.</li>
          <li>Prise de poids, constipation, peau sèche, chute de cheveux.</li>
          <li>Ralentissement du rythme cardiaque, baisse de moral.</li>
        </ul>
        <p class="small muted">Cause fréquente : thyroïdite auto-immune (Hashimoto). Le traitement est généralement une hormone substitutive, ajustée par bilan.</p>
      </details>

      <details>
        <summary>Hyperthyroïdie (thyroïde trop rapide)</summary>
        <ul>
          <li>Palpitations, nervosité, tremblements, transpiration.</li>
          <li>Perte de poids malgré l’appétit, insomnie.</li>
          <li>Diarrhée, intolérance à la chaleur.</li>
        </ul>
        <p class="small muted">Causes possibles : maladie de Basedow, nodules « autonomes ». Le traitement dépend de la cause.</p>
      </details>

      <details>
        <summary>Goitre et nodules thyroïdiens</summary>
        <ul>
          <li>Augmentation du volume de la thyroïde, parfois visible.</li>
          <li>Nodule : petite masse dans la glande, souvent bénigne.</li>
          <li>Évaluation typique : examen clinique + échographie ± ponction selon le risque.</li>
        </ul>

        <div class="media">
          <!-- Image nodule (mettre assets/img/nodule-thyroide.*) -->
          <img data-slug="nodule-thyroide" alt="Nodule thyroïdien (illustration)" loading="lazy" decoding="async">
          <div class="txt">
            <p class="muted small">
              Un nodule nécessite surtout une évaluation du risque. Beaucoup sont surveillés sans traitement.
            </p>
          </div>
        </div>
      </details>

      <details>
        <summary>Thyroïdites (inflammation)</summary>
        <ul>
          <li>Douleur au cou ou gêne, parfois fièvre (selon le type).</li>
          <li>Phase d’hyperthyroïdie transitoire puis parfois hypothyroïdie.</li>
          <li>Suivi biologique indispensable.</li>
        </ul>
      </details>

      <div class="sep"></div>

      <h2>3) Diagnostic : ce qui est le plus utile</h2>
      <ul>
        <li><strong>Bilan sanguin :</strong> TSH, T4 libre (± T3), parfois anticorps.</li>
        <li><strong>Échographie :</strong> structure, taille, nodules.</li>
        <li><strong>Selon les cas :</strong> scintigraphie, ponction d’un nodule, électrocardiogramme si palpitations.</li>
      </ul>

      <div class="sep"></div>

      <h2>4) Traitements : principes</h2>
      <ul>
        <li><strong>Hypothyroïdie :</strong> hormone substitutive, ajustée par la TSH.</li>
        <li><strong>Hyperthyroïdie :</strong> traitements anti-thyroïdiens, parfois bêtabloquants, parfois iode radioactif ou chirurgie.</li>
        <li><strong>Nodules :</strong> surveillance, ponction, chirurgie selon le risque et les symptômes.</li>
      </ul>

      <div class="badge" role="note">
        <span class="dot warn" aria-hidden="true"></span>
        <span class="small"><strong>Idée à retenir :</strong> l’ajustement du traitement se fait sur des bilans répétés, pas sur le ressenti seul.</span>
      </div>
    </article>

    <aside class="card">
      <h2>Signes qui doivent faire consulter rapidement</h2>

      <div class="badge">
        <span class="dot bad" aria-hidden="true"></span>
        <span class="small"><strong>Urgent :</strong> douleur thoracique, essoufflement, malaise, palpitations intenses ou irrégulières.</span>
      </div>

      <div class="badge">
        <span class="dot bad" aria-hidden="true"></span>
        <span class="small"><strong>Urgent :</strong> agitation extrême, confusion, fièvre avec accélération importante du cœur.</span>
      </div>

      <div class="badge">
        <span class="dot warn" aria-hidden="true"></span>
        <span class="small"><strong>À vérifier :</strong> perte de poids rapide, faiblesse marquée, tremblements persistants.</span>
      </div>

      <div class="badge">
        <span class="dot warn" aria-hidden="true"></span>
        <span class="small"><strong>À vérifier :</strong> fatigue durable, frilosité, constipation, peau très sèche.</span>
      </div>

      <div class="sep"></div>

      <h2>Conseils simples</h2>
      <ul>
        <li>Ne pas commencer d’iode, d’algues ou de « compléments thyroïde » sans avis médical.</li>
        <li>Noter les symptômes et leur date de début (utile pour la consultation).</li>
        <li>Si traitement hormonal : le prendre comme prescrit, et faire les bilans au bon moment.</li>
        <li>Sommeil, alimentation équilibrée, activité physique adaptée : utile, mais ne remplace pas le traitement.</li>
      </ul>

      <div class="sep"></div>

      <!-- Image à droite (mettre assets/img/cou-thyroide.*) -->
      <div class="media" style="margin-top:0;">
        <img data-slug="cou-thyroide" alt="Localisation de la thyroïde (cou)" loading="lazy" decoding="async">
        <div class="txt">
          <h3 style="margin:0 0 6px;">À propos des examens</h3>
          <p class="muted small" style="margin:0;">
            Les valeurs « normales » varient selon les laboratoires et le contexte (âge, grossesse, médicaments).
            L’interprétation doit être faite par un professionnel de santé.
          </p>
        </div>
      </div>
    </aside>
  </section>

  <section class="card" style="margin-top:14px;">
    <h2>Références (à lire si besoin)</h2>
    <ul>
      <li>Guides et fiches d’information de sociétés d’endocrinologie.</li>
      <li>Sites hospitaliers universitaires et services d’endocrinologie.</li>
      <li>Documents de santé publique sur le dosage TSH et l’évaluation des nodules.</li>
    </ul>
    <p class="small muted">
      Cette page est informative. Elle ne remplace pas une consultation ni un diagnostic.
    </p>
  </section>
</main>

<footer>
  <div class="small">YourHealth • Page : Maladies de la thyroïde</div>
</footer>

<script>
/* Charge automatiquement les images à partir de data-slug.
   Dossier: assets/img/
   Extensions testées: .jfif, .jpg, .jpeg, .png, .webp
   Image de secours: assets/img/default.jpg
*/
(function(){
  const base = "assets/img/";
  const fallback = base + "default.jpg";
  const exts = [".jfif",".jpg",".jpeg",".png",".webp"];

  async function exists(url){
    try{
      const r = await fetch(url, {method:"HEAD", cache:"no-store"});
      return r.ok;
    }catch(e){
      return false;
    }
  }

  document.querySelectorAll("img[data-slug]").forEach(async (img) => {
    const raw = (img.getAttribute("data-slug") || "").trim();
    if(!raw){
      img.src = fallback;
      return;
    }
    const slug = raw
      .toLowerCase()
      .normalize("NFD").replace(/[\u0300-\u036f]/g,"")
      .replace(/[^a-z0-9]+/g,"-")
      .replace(/^-+|-+$/g,"");

    // si src déjà défini, ne pas écraser
    if(img.getAttribute("src")) return;

    for(const ext of exts){
      const url = base + slug + ext;
      if(await exists(url)){
        img.src = url;
        return;
      }
    }
    img.src = fallback;
  });

  // Sécurité si une image ne charge pas (fichier manquant)
  document.addEventListener("error", (e) => {
    const el = e.target;
    if(el && el.tagName === "IMG"){
      el.src = fallback;
    }
  }, true);
})();
</script>

</body>
</html>
